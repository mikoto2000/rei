{
  "name": "rei-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/playwright.mjs",
    "lint": "eslint .",
    "format": "prettier --write src e2e scripts *.json *.ts *.html *.md",
    "format:check": "prettier --check src e2e scripts *.json *.ts *.html *.md",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-compiler": "npm:typescript@~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "source-map-js": "1.2.4",
    "minimatch": "11.0.9"
  }
}
