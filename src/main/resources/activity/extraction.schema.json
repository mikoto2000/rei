{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false,
  "required":["summary","confidence","activities"],
  "properties":{
    "summary":{"type":"string","minLength":1,"maxLength":2000},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "activities":{"type":"array","maxItems":32,"items":{
      "type":"object","additionalProperties":false,
      "required":["monitor","type","application","service","contentTitle","projectCandidate"],
      "properties":{
        "monitor":{"type":"string","minLength":1,"maxLength":256},
        "type":{"type":"string","minLength":1,"maxLength":128},
        "application":{"type":"string","maxLength":256},
        "service":{"type":"string","maxLength":256},
        "contentTitle":{"type":"string","maxLength":1000},
        "projectCandidate":{"type":"string","maxLength":256}
      }
    }}
  }
}
