      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "millis": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action",
    "risk",
    "target",
    "confidence",
    "text",
    "key",
    "amount",
